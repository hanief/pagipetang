{
  "expo": {
    "name": "Pagi Petang",
    "slug": "pagipetang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haniefutama.pagipetang"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.haniefutama.pagipetang"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Digital Khatt V2 Font.otf",
            "./assets/fonts/KFGQPC Uthmanic Script HAFS Regular.otf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Arabic",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/KFGQPC Uthmanic Script HAFS Regular.otf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Digital Khatt V2 Font.otf",
              "./assets/fonts/KFGQPC Uthmanic Script HAFS Regular.otf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d4a502b4-fef3-4561-bfa8-2fcc65151c8f"
      }
    }
  }
}
